%%{init: {'theme':'neutral','flowchart':{'curve':'basis'}}}%%
flowchart TD
  A["skigard add"] --> Q["Quarantine<br/>archive, never executed"]
  Q --> S["Scan<br/>deterministic rules"]
  S --> R["Agent review<br/>optional, advisory only"]
  R --> C["Score 1..10<br/>with reasons"]
  C --> D{"Mode"}
  D -- "auto: score >= threshold,<br/>no hard stop" --> L
  D -- "strict" --> H["Human approve<br/>real terminal, /dev/tty"]
  D -- "auto: below threshold" --> W["Stay in quarantine<br/>warning + next commands"]
  W -. "approve" .-> H
  H --> L[("skigard.lock<br/>commit + SHA-256 + mode")]
  L --> I["Install<br/>into detected harnesses"]
  L -.-> V["skigard verify<br/>CI drift check"]
  L -. "skigard update" .-> U["Re-fetch + diff"]
  U --> Q
  classDef human fill:#5AA9FF,stroke:#1d5fa8,color:#0b1a2b,stroke-width:2px
  classDef step fill:#eeeeee,stroke:#777777,color:#111111
  class H human
  class A,Q,S,R,C,D,W,L,I,V,U step
