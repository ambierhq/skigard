# Shared look for every scene. Palette from assets/brand/tokens.env (@ACCENT@ is substituted by demo.sh).
Set Shell "bash"
Set FontSize 14
Set FontFamily "Menlo"
Set Width 1280
Set Height 640
Set Padding 28
Set Margin 24
Set MarginFill "#0C0A07"
Set BorderRadius 10
Set WindowBar Colorful
Set WindowBarSize 36
Set TypingSpeed 45ms
Set Framerate 24
Set Theme { "name": "skigard", "black": "#16130E", "red": "#E5604D", "green": "#8FB573", "yellow": "#E8B84A", "blue": "#7FA6C9", "magenta": "#C58FB0", "cyan": "#7DB5AC", "white": "#F4EEE2", "brightBlack": "#B7A98C", "brightRed": "#F0806E", "brightGreen": "#A8CC8C", "brightYellow": "#F2CB74", "brightBlue": "#9DBCD8", "brightMagenta": "#D6A8C6", "brightCyan": "#9CCBC3", "brightWhite": "#FFFBF0", "background": "#16130E", "foreground": "#F4EEE2", "selection": "#3A3223", "cursor": "@ACCENT@" }
