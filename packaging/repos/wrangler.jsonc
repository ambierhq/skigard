{
  // Worker `ambier-releases`: static assets only, no code, no R2. Shared by every Ambier tool, so a deploy
  // must contain every tool's tree (today only skigard). Deploy with:
  //   wrangler deploy --config packaging/repos/wrangler.jsonc --assets <OUTDIR>
  // Limits: 25 MiB per file, 20,000 files (checked by build-all.sh).
  "name": "ambier-releases",
  "compatibility_date": "2026-01-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "releases.ambierhq.com", "custom_domain": true }],
  "assets": { "directory": "../../repos-dist", "html_handling": "none", "not_found_handling": "none" }
}
