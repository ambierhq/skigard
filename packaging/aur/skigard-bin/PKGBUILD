# Maintainer: Ambier Oy <skigard@ambierhq.com>
# Installs the prebuilt release binary. Checksums come from the release's checksums.txt (pinned by update.sh).
pkgname=skigard-bin
_name=skigard
pkgver=0.1.0
pkgrel=1
pkgdesc='Lockfile and review gate for agent skills (prebuilt binary)'
arch=('x86_64' 'aarch64')
url='https://github.com/ambierhq/skigard'
license=('MIT')
provides=('skigard')
conflicts=('skigard')
source_x86_64=("$_name-$pkgver-linux-amd64.tar.gz::$url/releases/download/v$pkgver/${_name}_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("$_name-$pkgver-linux-arm64.tar.gz::$url/releases/download/v$pkgver/${_name}_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')
options=('!strip')

package() {
  install -Dm755 skigard "$pkgdir/usr/bin/skigard"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
  install -Dm644 completions/skigard.bash "$pkgdir/usr/share/bash-completion/completions/skigard"
  install -Dm644 completions/_skigard "$pkgdir/usr/share/zsh/site-functions/_skigard"
  install -Dm644 completions/skigard.fish "$pkgdir/usr/share/fish/vendor_completions.d/skigard.fish"
}
