---
import "../styles/fonts.css";
import "../styles/ambier-tokens.css";
import "../styles/skigard.css";
import "../styles/landing.css";
import InstallTabs from "../components/InstallTabs.astro";
import Terminal from "../components/Terminal.astro";
import display from "../fonts/newsreader-latin-wght-normal.woff2?url";
import ui400 from "../fonts/ibm-plex-sans-latin-400-normal.woff2?url";
import ui600 from "../fonts/ibm-plex-sans-latin-600-normal.woff2?url";
import harnesses from "../data/harnesses.json";
import { software, faq, breadcrumbs, harnessCount } from "../lib/seo";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const title = "skigard: a safer way to manage agent skills for Claude Code, Codex and Cursor";
const description = `skigard is a safer way to manage agent skills (Claude Code, Codex, Cursor and more). One command fetches a skill to quarantine, scans it, scores it from 1 to 10, pins the exact bytes and installs it into ${harnessCount} agent harnesses, including Claude Code, Pi, Codex and Cursor, if it clears your threshold. Strict mode needs a human first. A score is not a safety proof.`;
const canonical = "https://ambierhq.com/skigard/";
const og = "https://ambierhq.com/skigard/og.png";
const verified = harnesses.filter((h) => h.verified);
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
const crumbs = breadcrumbs([
  ["Ambier", "https://ambierhq.com/"],
  ["Open source", "https://ambierhq.com/open-source/"],
  ["skigard", canonical],
]);
const cfToken = import.meta.env.CF_WEB_ANALYTICS_TOKEN;
const steps = [
  ["Add", "One command. Fetch the skill into a private quarantine. Nothing from it is executed."],
  ["Scan", "Deterministic rules and capability chains. High and critical findings block."],
  ["Review", "An agent you already use reads it with tools off (on by default, one setting turns it off). It can only add doubt, never remove a finding."],
  ["Score", "A safety score from 1 to 10, always with its reasons. Scanner blocks and failing reviews are hard stops."],
  ["Decide", "Auto mode installs at or above your threshold. Strict mode always asks you in a real terminal. Below the threshold the skill stays in quarantine until a human approves it, or forces the install, at a terminal."],
  ["Lock", "The decision is pinned to a content hash in skigard.lock, with its mode (human, auto, local or forced). Commit it."],
  ["Install", "Link into every harness skigard finds. Drift is caught by verify."],
];
const features = [
  ["Approval needs a human at a terminal", "No --yes, no stdin or environment path, and skigard refuses approve, forced installs and mode changes inside the agent harnesses it can detect. A process that creates its own pseudo-terminal can still type the answer, so the gate stops accidents and ordinary prompt injection, not a determined agent. In auto mode an agent's add can install skills that clear your threshold. Signed approvals are planned."],
  ["Hash-pinned lockfile", "Source, commit, content hash, scan, review, score and approval mode, for every skill."],
  ["Hostile-input safe", "Archives are extracted through os.Root. Links, devices and bombs are refused."],
  ["Sandboxed reviewer", "Tools off, empty directory, scrubbed environment, OS sandbox on macOS and Linux."],
  ["Local forks that survive updates", "edit, adopt and merge keep your changes to a skill. Updates never overwrite them and merges always need a human."],
  ["Drift detection", "verify fails when the lock, the store or the installs change, and the marketplace if you enabled it."],
  ["One static binary", "macOS, Linux and Windows. No runtime, no telemetry, one dependency."],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={display} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={ui400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={ui600} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="theme-color" content="#16130E" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="skigard by Ambier" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:alt" content="skigard: a safer way to manage agent skills for Claude Code, Codex and Cursor" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <link rel="alternate" type="text/plain" href={`${base}/llms.txt`} title="llms.txt" />
    <script type="application/ld+json" set:html={JSON.stringify(software)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(crumbs)} />
    {cfToken && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfToken })}></script>}
  </head>
  <body>
    <header class="site">
      <div class="wrap row">
        <a class="brand" href={`${base}/`}><img src={`${base}/logo.svg`} alt="" width="28" height="28" /><span>skigard</span></a>
        <nav aria-label="Main">
          <a href={`${base}/docs/install/`}>Docs</a>
          <a href={`${base}/docs/threat-model/`}>Threat model</a>
          <a href="https://github.com/ambierhq/skigard">GitHub</a>
        </nav>
      </div>
    </header>
    <main>
      <section class="hero wrap">
        <div>
          <h1 class="display">A safer way to manage agent skills.</h1>
          <p class="lede">One command scans, scores (1 to 10), pins and installs a skill. Auto mode installs what clears your threshold; strict mode makes a human approve those exact bytes first. A score is a recommendation, not a proof of safety.</p>
          <InstallTabs />
        </div>
        <Terminal />
      </section>

      <section class="wrap block" id="problem">
        <h2 class="display">Skills are code your agent trusts</h2>
        <p>A <code>SKILL.md</code> and its bundled scripts steer an agent that can read your files and run commands. Skills are installed from random repositories, change under a moving branch and can hide instructions the agent obeys. Package managers solved the equivalent problem with lockfiles and review. Agent skills still get <code>git clone</code> and hope.</p>
      </section>

      <section class="wrap block" id="how">
        <h2 class="display">How it works</h2>
        <img class="pipeline" src={`${base}/diagrams/pipeline-dark.svg`} width="880" height="252" alt="skigard pipeline: add to quarantine, scan, agent review, safety score, auto-install above the threshold or human approve in a real terminal, skigard.lock, install; update loops back to quarantine and verify checks drift from the lock" />
        <ol class="steps">
          {steps.map(([h, t]) => <li><h3>{h}</h3><p>{t}</p></li>)}
        </ol>
      </section>

      <section class="wrap block" id="demo">
        <h2 class="display">See it work</h2>
        <p>An approve attempt from inside an agent harness is refused. A human approves in a real terminal (strict mode, or a skill held below your threshold). Tampering after approval makes <code>verify</code> fail. About 90 seconds, no sound.</p>
        <video controls preload="none" playsinline poster={`${base}/media/poster.png`} width="1280" height="720" aria-label="skigard demo: scan blocks a malicious-looking skill, an agent is refused at approve, a human approves, verify fails after tampering">
          <source src={`${base}/media/demo.webm`} type="video/webm" />
          <source src={`${base}/media/demo.mp4`} type="video/mp4" />
          <p>Your browser cannot play the video. The commands are in <a href={`${base}/docs/getting-started/`}>Getting started</a>.</p>
        </video>
      </section>

      <section class="wrap block" id="features">
        <h2 class="display">What you get</h2>
        <ul class="cards">
          {features.map(([h, t]) => <li><h3>{h}</h3><p>{t}</p></li>)}
        </ul>
      </section>

      <section class="wrap block" id="harnesses">
        <h2 class="display">{harnesses.length} agent harnesses in the registry</h2>
        <p>{verified.length} are verified against the harness itself (highlighted). The rest are detected and listed but installed to only with <code>--include-unverified</code>. <a href={`${base}/docs/harnesses/`}>Paths and details</a>. Missing yours? <a href="https://github.com/ambierhq/skigard/blob/main/CONTRIBUTING.md">Send a PR</a>.</p>
        <ul class="grid">
          {harnesses.map((h) => <li class={h.verified ? "v" : ""}>{h.name}{h.verified && <span class="sr"> (verified)</span>}</li>)}
        </ul>
      </section>

      <section class="wrap block" id="limits">
        <h2 class="display">Honest limits</h2>
        <ul class="limits">
          <li>The scanner is heuristic and an agent review can be fooled. <strong>A pass or a score of 10 is not a safety certificate.</strong> Read the skill, especially bundled scripts, or use strict mode.</li>
          <li>In auto mode an agent that runs <code>skigard add</code> can install skills that clear your threshold. The lock records it as <code>mode = auto</code> and <code>verify --require-human</code> fails on it. Agents cannot approve, force an install or change the mode or threshold.</li>
          <li>Read-only approved skills are a deterrent, not a boundary: anything running as you can <code>chmod</code> them back. The lock hash is the control.</li>
          <li>Approval is a terminal prompt, not a signature. A process that creates its own pseudo-terminal can type the answer; skigard only refuses inside harnesses it can detect. Signed approvals are planned.</li>
          <li>Someone who can already write to your home as you can do anything. skigard does not defend against that.</li>
          <li>Automated review is disabled on Windows (it has no sandbox); use <code>review --manual</code>.</li>
          <li>Most harness entries are unverified. We say so instead of guessing.</li>
        </ul>
        <p><a href={`${base}/docs/threat-model/`}>Read the full threat model</a>.</p>
      </section>

      <section class="wrap block" id="verify">
        <h2 class="display">Verify our releases</h2>
        <p>Every release carries SHA-256 checksums, a keyless cosign signature, an SBOM per archive and GitHub build provenance attestations. The npm packages carry npm provenance. <a href={`${base}/docs/install/#verify-what-you-downloaded`}>How to check them</a>.</p>
      </section>

      <section class="wrap block" id="faq">
        <h2 class="display">FAQ</h2>
        {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </section>
    </main>
    <footer class="site-footer">
      <div class="wrap footer-row">
        <p>A project by <a href="https://ambierhq.com/">Ambier Oy</a>, Finland. MIT licensed.</p>
        <p><a href="https://github.com/ambierhq/skigard">GitHub</a> · <a href={`${base}/docs/install/`}>Docs</a> · <a href={`${base}/llms.txt`}>llms.txt</a></p>
      </div>
    </footer>
  </body>
</html>
