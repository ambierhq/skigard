---
import "../styles/fonts.css";
import "../styles/ambier-tokens.css";
import "../styles/skigard.css";
import "../styles/landing.css";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found | skigard</title>
    <meta name="description" content="This page does not exist. Start at the skigard install guide." />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <main class="wrap block" style="border:0;padding-top:5rem">
      <h1 class="display">Page not found</h1>
      <p>That page does not exist. Try the <a href={`${base}/docs/install/`}>install guide</a> or the <a href={`${base}/`}>skigard home page</a>.</p>
    </main>
  </body>
</html>
